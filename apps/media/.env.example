MEDIA_PORT=3001
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173
MEDIA_DATABASE_URL=postgresql://findam:findam@localhost:5432/findam?schema=media
MEDIA_STORAGE_PATH=./storage
