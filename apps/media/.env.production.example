# Copy to .env.production on the VPS and replace every placeholder.
NODE_ENV=production
MEDIA_PORT=3001
API_PREFIX=api/v1
CORS_ORIGIN=https://admin.grastadomham.com
MEDIA_DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@127.0.0.1:5432/findam?schema=media
MEDIA_STORAGE_PATH=/var/lib/findam/media

# Must be byte-for-byte identical to apps/api/.env.production JWT_ACCESS_SECRET.
JWT_ACCESS_SECRET=REPLACE_WITH_THE_API_ACCESS_SECRET
