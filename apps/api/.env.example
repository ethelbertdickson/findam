# --- App ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:8081

# --- Database (PostgreSQL + PostGIS) ---
DATABASE_URL="postgresql://findam:findam@localhost:5432/findam?schema=public"

# --- JWT ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Self-hosted media service ---
# Keep "cloudinary" until MEDIA_API_KEY has been generated in the admin console.
STORAGE_PROVIDER=cloudinary
MEDIA_SERVICE_URL=http://127.0.0.1:3001
# Use your computer's LAN address here when testing from a physical phone.
MEDIA_PUBLIC_URL=http://localhost:3001
MEDIA_PROJECT_SLUG=findam
MEDIA_API_KEY=
# Optional; the folder must already exist inside the Findam media project.
MEDIA_FOLDER_PATH=

# --- Google authentication ---
# Comma-separate the Web, Android, and iOS OAuth client IDs you accept.
GOOGLE_CLIENT_IDS=

# Free key from https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=

# --- Rate limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100
