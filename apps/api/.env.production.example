# Copy to .env.production on the VPS and replace every placeholder.
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=https://admin.grastadomhan.com,https://grastadomhan.com,https://www.grastadomhan.com,https://findam.grastadomhan.com,http://localhost:8081,http://localhost:8082
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@127.0.0.1:5432/findam?schema=public

# Generate unique random values. The media service must use the same access secret.
JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_ACCESS_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=30d

# ProjectorPro secrets are intentionally kept outside the repository in
# /etc/findam/projectorpro.env (loaded by systemd after this file).

STORAGE_PROVIDER=self-hosted
MEDIA_SERVICE_URL=http://127.0.0.1:3001
# Browser-facing URL. Nginx must proxy /media/ on this host to port 3001.
MEDIA_PUBLIC_URL=https://api.grastadomhan.com
MEDIA_PROJECT_SLUG=findam
MEDIA_API_KEY=REPLACE_WITH_PRODUCTION_FINDAM_MEDIA_API_KEY
MEDIA_FOLDER_PATH=

GOOGLE_CLIENT_IDS=
GEOAPIFY_API_KEY=REPLACE_WITH_GEOAPIFY_KEY
GOOGLE_MAPS_API_KEY=REPLACE_WITH_GOOGLE_MAPS_PLACES_KEY
# ProjectorPro public download tracking. Keep the archive outside the repository.
PROJECTORPRO_DOWNLOAD_FILE=/var/lib/findam/downloads/projectorpro/ProjectorPro-latest.zip
PROJECTORPRO_DOWNLOAD_VERSION=latest
DOWNLOAD_ROOT=/var/lib/findam/downloads
DOWNLOAD_IP_SALT=REPLACE_WITH_LONG_RANDOM_DOWNLOAD_SALT
THROTTLE_TTL=60
THROTTLE_LIMIT=100
