{
  "name": "findam",
  "private": true,
  "version": "1.0.0",
  "description": "Findam - property, land and household marketplace monorepo (Expo mobile app + NestJS API). Each app under apps/ manages its own dependencies independently.",
  "scripts": {
    "api:dev": "npm --prefix apps/api run start:dev",
    "api:build": "npm --prefix apps/api run build",
    "api:admin:create": "npm --prefix apps/api run admin:create",
    "console:dev": "npm --prefix apps/api-console run dev",
    "console:build": "npm --prefix apps/api-console run build",
    "media:dev": "npm --prefix apps/media run start:dev",
    "media:build": "npm --prefix apps/media run build",
    "mobile:start": "npm --prefix apps/mobile run start",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  }
}
