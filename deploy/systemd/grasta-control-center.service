[Unit]
Description=Grasta Domhan Control Centre connector service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/findam/apps/control-center
EnvironmentFile=/var/www/findam/apps/control-center/.env
ExecStart=/usr/bin/node /var/www/findam/apps/control-center/dist/server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
